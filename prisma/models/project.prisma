model Project {
  id          Int      @id @default(autoincrement())
  source      ProjectSource @default(personal)
  title       String
  slug        String   @unique
  description String
  image       String
  linkDemo   String?
  linkGithub String?
  stacks      String
  isShow     Boolean  @default(true)
  updatedAt  DateTime @default(now())
  content     String?  @db.Text
  order       Int      @default(autoincrement())
  
  // ProjectTag와의 관계
  projectTags ProjectTag[]
}

enum ProjectSource {
  personal
  company
}
