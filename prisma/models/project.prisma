model Project {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String
  image       String
  linkDemo   String?
  linkGithub String?
  stacks      String
  isShow     Boolean  @default(true)
  updatedAt  DateTime @default(now())
  content     String?  @db.Text
  order       Int      @default(autoincrement())
}