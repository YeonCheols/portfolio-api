enum ResumeModelEnvironment {
  development
  production
}

enum ResumeModelProvider {
  openrouter
  openai
  gemini
}

// 환경별 활성 설정 하나는 마이그레이션의 부분 유니크 인덱스가 강제한다
model ResumeModelSetting {
  id          Int                    @id @default(autoincrement())
  environment ResumeModelEnvironment
  provider    ResumeModelProvider
  modelName   String
  url         String
  // 이관 전 참조명은 보존하지만 런타임에서는 사용하지 않는다
  secretRef   String?
  apiKey      String?
  isActive    Boolean                @default(false)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([environment])
}
