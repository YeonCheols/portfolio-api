// 런타임의 @prisma/client는 기본 위치(pnpm 패키지 옆 .prisma/client)를 읽는다
generator client {
  provider = "prisma-client-js"
}

// @vercel/node 타입 검사는 심볼릭 링크를 따라가지 않으므로 루트 node_modules에도 생성한다
generator clientTypes {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model Profile {
  id          Int      @id @default(autoincrement())
  name       String @default("")
  imageUrl   String
  isActive   Boolean  @default(false)
  order       Int      @default(autoincrement())
  updatedAt  DateTime @default(now())

  @@index([order])
} 

model ProjectTag {
  id        Int      @id @default(autoincrement())
  projectId Int
  tagId     Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@unique([projectId, tagId])
  @@index([projectId])
  @@index([tagId])
} 

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String
  image       String
  linkDemo   String?
  linkGithub String?
  stacks      String
  isShow     Boolean  @default(true)
  updatedAt  DateTime @default(now())
  content     String?  @db.Text
  order       Int      @default(autoincrement())
  
  // ProjectTag와의 관계
  projectTags ProjectTag[]
}

enum ResumeModelEnvironment {
  development
  production
}

enum ResumeModelProvider {
  openrouter
}

// 환경별 활성 설정 하나는 마이그레이션의 부분 유니크 인덱스가 강제한다
model ResumeModelSetting {
  id          Int                    @id @default(autoincrement())
  environment ResumeModelEnvironment
  provider    ResumeModelProvider
  modelName   String
  url         String
  secretRef   String
  isActive    Boolean                @default(false)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([environment])
}


model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  icon      String
  color     String
  category  String
  updatedAt DateTime @default(now())
  
  // ProjectTag와의 관계
  projectTags ProjectTag[]
}


enum UserIdentityProvider {
  github
}

model User {
  id           Int            @id @default(autoincrement())
  email        String?
  name         String?
  imageUrl     String?
  identities   UserIdentity[]
  authHistories AuthHistory[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model UserIdentity {
  id             Int                  @id @default(autoincrement())
  provider       UserIdentityProvider
  providerUserId String
  userId         Int
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([provider, providerUserId])
  @@index([userId])
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AuthHistoryStatus {
  pending
  authenticated
  failed
  revoked
}

model AuthHistory {
  id              String            @id @default(uuid()) @db.Uuid
  clientId        String
  userId          Int?
  user            User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri     String?
  stateHash       String?           @unique
  stateExpiresAt  DateTime?
  stateConsumedAt DateTime?
  audience        String?
  scope           String?
  status          AuthHistoryStatus @default(pending)
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tokens          UserToken[]

  @@index([userId, clientId, status])
  @@index([expiresAt])
}

model UserToken {
  id            String      @id @default(uuid()) @db.Uuid
  authHistoryId String      @db.Uuid
  authHistory   AuthHistory @relation(fields: [authHistoryId], references: [id], onDelete: Cascade)
  tokenHash     String      @unique
  expiresAt     DateTime
  consumedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())

  @@index([authHistoryId, revokedAt])
  @@index([expiresAt])
}
